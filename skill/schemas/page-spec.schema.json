{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emersonSantos98/skill-pagina-de-vendas/schemas/page-spec.schema.json",
  "title": "page-spec",
  "description": "Especificação de página de vendas. Validação semântica completa: scripts/validar-spec.mjs.",
  "type": "object",
  "required": ["meta", "objections", "proofs", "modules", "ctas", "offer", "legal"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["product_type", "ticket", "awareness", "sophistication", "traffic_sources", "goal", "framework"],
      "properties": {
        "projeto": { "type": "string" },
        "product_type": { "enum": ["infoproduto", "curso", "mentoria", "comunidade", "saas", "saas_b2b", "ferramenta", "assinatura", "servico"] },
        "ticket": {
          "type": "object",
          "required": ["faixa"],
          "properties": { "valor": { "type": "number" }, "moeda": { "type": "string" }, "faixa": { "enum": ["baixo", "medio", "alto"] } }
        },
        "awareness": { "enum": ["inconsciente", "problema", "solucao", "produto", "muito_consciente"] },
        "sophistication": { "type": "integer", "minimum": 1, "maximum": 5 },
        "traffic_sources": { "type": "array", "minItems": 1, "items": { "enum": ["frio_pago", "morno", "quente_email", "remarketing", "organico", "busca_marca", "busca_problema", "busca_categoria", "afiliado", "indicacao"] } },
        "ad_match": { "type": "string" },
        "goal": { "enum": ["compra", "trial", "freemium", "demo", "aplicacao", "call", "lista_espera", "lead", "whatsapp"] },
        "length": { "enum": ["curta", "media", "longa"] },
        "hero_type": { "enum": ["promessa", "historia", "oferta", "demonstracao", "identificacao", "vsl"] },
        "sensitive_niche": { "type": "boolean" },
        "framework": {
          "type": "object",
          "required": ["primario"],
          "properties": { "primario": { "type": "string" }, "secundario": { "type": "string" }, "justificativa": { "type": "string" } }
        },
        "big_idea": { "type": "string" },
        "mechanism": { "type": "string" }
      }
    },
    "beliefs_map": {
      "type": "array",
      "items": { "type": "object", "properties": { "belief": { "type": "string" }, "status": { "enum": ["ja_existe", "precisa_instalar"] }, "modules": { "type": "array", "items": { "type": "string" } } } }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "answered_by"],
        "properties": {
          "id": { "type": "string" }, "text": { "type": "string" },
          "source": { "enum": ["pesquisa", "suporte", "vendas", "review_concorrente", "referencia", "hipotese"] },
          "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
          "answered_by": { "type": "array", "items": { "type": "string" } },
          "proof_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "verified"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["depoimento", "case", "numero", "logo", "credencial", "midia", "review", "demo", "garantia"] },
          "verified": { "const": true },
          "consent": { "type": "boolean" },
          "name": { "type": "string" }, "role_or_context": { "type": "string" }, "avatar": { "type": "string" },
          "result": { "type": "string" }, "before": { "type": "string" }, "after": { "type": "string" },
          "format": { "enum": ["texto", "video", "print", "audio"] }, "date": { "type": "string" },
          "material_connection": { "type": "string" }, "typicality_note": { "type": "string" }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "purpose": { "type": "string" },
          "journey_stage": { "type": "integer", "minimum": 1, "maximum": 9 },
          "objections": { "type": "array", "items": { "type": "string" } },
          "proof_ids": { "type": "array", "items": { "type": "string" } },
          "copy": { "type": "object", "properties": { "headline": { "type": "string" }, "body": { "type": "string" }, "bullets": { "type": "array", "items": { "type": "string" } }, "microcopy": { "type": "string" } } },
          "layout": { "type": "object", "properties": { "desktop": { "type": "string" }, "mobile": { "type": "string" }, "visual": { "enum": ["texto", "imagem", "video", "gif", "tabela", "cards"] } } },
          "evidence_level": { "enum": ["E", "C", "O", "T"] }
        }
      }
    },
    "omitted": { "type": "array", "items": { "type": "object", "required": ["type", "motivo"], "properties": { "type": { "type": "string" }, "motivo": { "type": "string" } } } },
    "ctas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "intent", "hierarchy", "destination"],
        "properties": {
          "id": { "type": "string" }, "label": { "type": "string" },
          "intent": { "enum": ["comprar", "assinar", "trial", "demo", "aplicar", "agendar", "lista_espera", "whatsapp", "lead", "ver_mais"] },
          "hierarchy": { "enum": ["primario", "secundario"] },
          "destination": { "type": "string" },
          "position": { "type": "array", "items": { "enum": ["hero", "meio", "pos_oferta", "final", "sticky_mobile"] } },
          "context_microcopy": { "type": "string" },
          "urgency": { "type": "object", "properties": { "level": { "enum": ["nenhuma", "real_prazo", "real_vagas"] }, "deadline_iso": { "type": "string" }, "justification": { "type": "string" } } }
        }
      }
    },
    "offer": {
      "type": "object",
      "properties": {
        "core": { "type": "string" },
        "deliverables": { "type": "array", "items": { "type": "object", "properties": { "item": { "type": "string" }, "objection_resolved": { "type": "string" } } } },
        "bonuses": { "type": "array", "items": { "type": "object", "properties": { "item": { "type": "string" }, "objection_resolved": { "type": "string" }, "valor": { "type": "number" }, "value_basis": { "type": "string" }, "expires": { "type": "string" } } } },
        "price": { "type": "object", "properties": { "avista": { "type": "number" }, "parcelas": { "type": "object", "properties": { "n": { "type": "integer" }, "valor": { "type": "number" }, "juros": { "type": "boolean" } } }, "recorrencia": { "enum": ["nenhuma", "mensal", "trimestral", "anual"] } } },
        "anchor": { "type": "object", "properties": { "tipo": { "enum": ["preco_anterior_real", "custo_alternativa", "nenhum"] }, "valor": { "type": "number" }, "fonte": { "type": "string" } } },
        "guarantee": { "type": "object", "properties": { "dias": { "type": "integer", "minimum": 7 }, "condicional": { "type": "boolean" }, "texto": { "type": "string" } } },
        "cancellation": { "type": "object", "properties": { "metodo": { "type": "string" }, "cliques_estimados": { "type": "integer" } } },
        "scarcity": { "type": "object", "properties": { "real": { "type": "boolean" }, "motivo": { "type": "string" } } }
      }
    },
    "legal": {
      "type": "object",
      "required": ["razao_social", "documento", "contato"],
      "properties": { "razao_social": { "type": "string" }, "documento": { "type": "string" }, "endereco": { "type": "string" }, "contato": { "type": "string" }, "termos_url": { "type": "string" }, "privacidade_url": { "type": "string" } }
    }
  }
}
